# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=
# Supabase → Project Settings → API Keys → Publishable key (or legacy "anon")
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase → Project Settings → API Keys → Secret key (or legacy "service_role"). Server only!
SUPABASE_SERVICE_ROLE_KEY=
# Supabase → Connect → Session pooler URI, with your database password filled in. Scripts only.
DATABASE_URL=
# Code instructors type to unlock the Instructor role
INSTRUCTOR_ACCESS_CODE=
# Footer feedback link (leave empty to hide it)
NEXT_PUBLIC_FEEDBACK_URL=
